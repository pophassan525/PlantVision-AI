# PlantVision AI — environment configuration example
# Copy this file to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
DATABASE_PATH=data/plantvision.db

# --- Model paths (populated once models are trained — Phase 2+) ---
PLANT_CLASSIFIER_PATH=models/plant_classifier/model.pt
DISEASE_CLASSIFIER_PATH=models/disease_classifier/model.pt
PEST_DETECTOR_PATH=models/pest_detector/model.pt
SEVERITY_MODEL_PATH=models/severity/model.pt

# --- RAG / LLM (Phase 9) ---
# NEVER commit a real key. Leave blank until RAG phase begins.
ANTHROPIC_API_KEY=
RAG_VECTOR_STORE_PATH=data/knowledge/vector_store

# --- Hardware ---
# auto = detect GPU if available, else fall back to CPU
DEVICE=auto
